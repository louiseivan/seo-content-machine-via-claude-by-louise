# Credentials template for the Ryder SEO content machine.
# Copy to shopify.env (same directory), fill in real values, chmod 600.
# The real shopify.env is gitignored — never commit credentials.

# Shopify custom app (Admin API, client-credentials grant)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=REPLACE_ME
SHOPIFY_CLIENT_SECRET=REPLACE_ME

# Notion internal integration (share your content database with it)
NOTION_API_KEY=REPLACE_ME

# Slack bot (chat:write; chat:write.customize for custom display name)
SLACK_BOT_TOKEN=REPLACE_ME

# DataForSEO (keyword research; Google volumes + difficulty)
DATAFORSEO_LOGIN=REPLACE_ME
DATAFORSEO_PASSWORD=REPLACE_ME

# Ahrefs API v3 (optional second keyword provider)
AHREFS_API_KEY=REPLACE_ME
