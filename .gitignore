# Whitelist repo: only the content machine is tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CLAUDE.md
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ryder-buyer-seo/
/.claude/skills/ryder-buyer-seo/*
!/.claude/skills/ryder-buyer-seo/SKILL.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/test.yml
!/CLAUDE OUTPUTS/
!/ryder-shopify-autopilot/

# Secrets — never commit these
CLAUDE OUTPUTS/Ryder One/shopify.env
CLAUDE OUTPUTS/Ryder One/gsc-service-account.json
*.env
!*.env.example
*service-account*.json

# Internal-only documents (stay local + in Notion, not in the public repo)
CLAUDE OUTPUTS/Ryder One/RYDER_CONTENT_SYSTEM_PROMPT.md
CLAUDE OUTPUTS/Ryder One/CONTENT-MACHINE-SETUP.md
CLAUDE OUTPUTS/Ryder One/Ryder-SEO-Automation-Playbook.pdf
CLAUDE OUTPUTS/Ryder One/outputs/

# OS noise
.DS_Store
**/.DS_Store
**/__pycache__/
*.pyc

# standalone repo, pushed separately to github.com/louiseivan
trustpilot-reviews-scraper/

# Production content queue. Stays local: push_articles.find_body() globs this
# directory for article bodies at publish time, so the machine needs it on
# disk, but only the five sample articles below ship in this repo.
CLAUDE OUTPUTS/Ryder One/rewrites/*
!CLAUDE OUTPUTS/Ryder One/rewrites/new-66-*
!CLAUDE OUTPUTS/Ryder One/rewrites/new-67-*
!CLAUDE OUTPUTS/Ryder One/rewrites/new-68-*
!CLAUDE OUTPUTS/Ryder One/rewrites/new-69-*
!CLAUDE OUTPUTS/Ryder One/rewrites/new-70-*

# Per-article cover engravings from generate_visuals.py. Five tracked to
# match the sample articles; the rest are Ryder brand output.
ryder-shopify-autopilot/assets/brand/art/*
!ryder-shopify-autopilot/assets/brand/art/coldcard-entropy-incident-explained.png
!ryder-shopify-autopilot/assets/brand/art/tangem-vs-ryder-one.png
!ryder-shopify-autopilot/assets/brand/art/cold-storage-setup-guide-2026.png
!ryder-shopify-autopilot/assets/brand/art/trezor-safe-7-vs-ryder-one.png
!ryder-shopify-autopilot/assets/brand/art/best-crypto-wallet-for-beginners-2026.png

# Scrape cache: third-party page content, never republished
.firecrawl/
